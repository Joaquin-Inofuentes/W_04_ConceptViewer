{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/concept/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/concept/escucha-accesos.js",
      "destination": "/escucha-accesos.js"
    },
    {
      "source": "/concept/favicon.svg",
      "destination": "/favicon.svg"
    },
    {
      "source": "/concept/icons.svg",
      "destination": "/icons.svg"
    },
    {
      "source": "/concept/version.txt",
      "destination": "/version.txt"
    },
    {
      "source": "/concept/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/concept",
      "destination": "/index.html"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(concept/)?assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "buildCommand": "npm run build && node -e \"require('fs').writeFileSync('dist/version.txt', process.env.VERCEL_GIT_COMMIT_SHA || 'local')\"",
  "outputDirectory": "dist",
  "installCommand": "npm install"
}